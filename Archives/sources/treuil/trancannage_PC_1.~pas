            end;
    end; // case state_calibr_acc of
   end;

   2: begin
    inc(state_calibr_acc);
    case state_calibr_acc of
        1 : begin
            sendbyte(port,COMMAND_TEST_ARMATURE_TANGAGE);
            memo1.Lines.Add('-Début procédure calibration magnétos');
            btn_calibr_acc.Caption:='étape 1';
            memo1.Lines.Add('X vers le sud');
            memo1.Lines.Add('  puis cliquer sur ''étape 1''');
            sendbyte(port,COMMAND_TEST_ARMATURE_ROULIS);
            end;
