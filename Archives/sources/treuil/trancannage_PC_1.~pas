procedure read_eeprom_file2;
var s:string;
    i:byte;
    temp_int:integer;
    temp_real:single;
     ptr_int : ^byte;
begin
     ptr_i:=@eepr;
     for i:=0 to (OFFSET_FLOAT-1) do
     begin
       readln(g,s);
       temp_int:= strtoint(s);
       ptr_i^:=temp_int and $FF;
       inc(ptr_i);
       ptr_i^:=(temp_int and $FF00) shr 8;
       inc(ptr_i);
       ptr_i^:=(temp_int and $FF0000) shr 16;
       inc(ptr_i);
       ptr_i^:=(temp_int and $FF000000) shr 24;
       inc(ptr_i);
       if connected then send_int(temp_int,128+i);
       delay(2);
      end;
     i:=OFFSET_FLOAT;
     repeat
       readln(g,s);
       temp_real:= strtofloat(s);
       ptr_int:=@temp_real;
       ptr_i^:=ptr_int^;
       inc(ptr_i);
       inc(ptr_int);
       ptr_i^:=ptr_int^;
       inc(ptr_i);
       inc(ptr_int);
       ptr_i^:=ptr_int^;
       inc(ptr_i);
       inc(ptr_int);
       ptr_i^:=ptr_int^;
       inc(ptr_i);
       if connected then send_float(temp_real,128+i);
       i:=i+2;
       delay(2);
      until (i > OFFSET_FLOAT+OFFSET_END_FLOAT);
end;
