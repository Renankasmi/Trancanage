procedure send_int(s_int : integer;s_adr : integer);
begin
     sendbyte(port,s_adr);
     //on envoie les 2 octets de la valeur en int +2 dummies
     sendbyte(port,s_int shr 8);
     sendbyte(port,s_int and $FF);
     sendbyte(port,0);
     sendbyte(port,0);
end;
procedure send_float(s_float : single;s_adr : integer);
var s_temp : int64;
begin
     sendbyte(port,s_adr);
     //on envoie les 4 octets de la valeur en float
     ptr_long:=@s_float;
     s_temp:=ptr_long^;
     sendbyte(port,(s_temp shr 8)and $FF);
     sendbyte(port,s_temp and $FF); //word poids faible
     sendbyte(port,s_temp shr 24);
     sendbyte(port,(s_temp shr 16)and $FF);//word poids fort
end;


procedure TForm1.init_tracks(Sender: TObject);
var k:integer;
begin
if   modif_controls=true then
 begin
   modif_controls:=false;
    case tabcontrol1.TabIndex of
        0: begin   //installation
             Label1.Visible:=true;
             Label2.Visible:=true;
             Label3.Visible:=true;
             Label4.Visible:=true;
             label1.Caption:='seuil_tension';
             label2.Caption:='inertie';
             label3.Caption:='Xcourant';
             label4.Caption:='F_loop';
             tb_k1.Visible:=true;
             tb_k2.Visible:=true;
             tb_k3.Visible:=true;
             tb_k4.Visible:=true;
             lb_k1.Visible:=true;
             lb_k2.Visible:=true;
             lb_k3.Visible:=true;
             lb_k4.Visible:=true;
             tb_k1.Position:=round(eepr.seuil_tension / 283);
             tb_k2.Position:=round(eepr.inertie);
             tb_k3.Position:=round(eepr.Xcourant);
             tb_k4.Position:=(eepr.freq_boucle div 10)-10;
             lb_k1.Caption:=inttostr((tb_k1.Position*283));
             lb_k2.Caption:=inttostr((tb_k2.Position));
             lb_k3.Caption:=inttostr((tb_k3.Position));
             lb_k4.Caption:=inttostr((tb_k4.Position +10)*10)+'Hz';

           end;
        1: begin   //imu
            cb_reg1.ItemIndex:=(eepr.sensor_set shr 8)and $0F;
            cb_reg2.ItemIndex:=(eepr.sensor_set shr 4)and $0F;
            cb_reg3.ItemIndex:=(eepr.sensor_set)and $0F;
            case rg_sensor.ItemIndex of
              1: begin lb_reg1.Caption:='gyr_x>0 Roll à droite';
                       lb_reg2.Caption:='gyr_y>0 Tilt à cabré';
                       lb_reg3.Caption:='gyr_z,Pan>0 à droite';
                 end;
              2: begin lb_reg1.Caption:='acc_x>0 Tilt à cabré';
                       lb_reg2.Caption:='acc_y>0 Roll à gauche';
                       lb_reg3.Caption:='  acc_z<0 à plat';
                 end;
              3: begin lb_reg1.Caption:='mag_x>0 nez au nord';
                       lb_reg2.Caption:='  mag_y>0 à l''ouest';
                       lb_reg3.Caption:='mag_z>0 bas au nord';
                 end;
             end;
            rg_roll.ItemIndex:=(eepr.flags and $03); //b1,b0
            rg_tilt.ItemIndex:=(eepr.flags shr 7)and $01; //b7

             Label1.Visible:=true;
             Label3.Visible:=true;
             Label4.Visible:=true;
             if rg_tilt.ItemIndex=0 then
              begin
                     label1.Caption:='Kp';
                     label2.Caption:='Ki';
                     Label2.Visible:=true;
                     tb_k2.Visible:=true;
                     lb_k2.Visible:=true;
                     tb_k2.Position:=round(eepr.Ki_imu*100);
                end
              else
             begin
                     label1.Caption:='gyr_drift';
               end;

             label3.Caption:='w_scale';
             label4.Caption:='Xacc';
             tb_k1.Visible:=true;
             tb_k3.Visible:=true;
             tb_k4.Visible:=true;
             lb_k1.Visible:=true;
             lb_k3.Visible:=true;
             lb_k4.Visible:=true;

             tb_k1.Position:=round(eepr.Kp_imu*10);

             case rg_roll.ItemIndex of
               0 : begin
               tb_k3.Position:=((eepr.gyro_scale[rg_roll.ItemIndex]-7000)div 16)+50;
               lb_k3.Caption:=inttostr(((tb_k3.Position-50)*16)+7000);
                   end;
               1 : begin
               tb_k3.Position:=((eepr.gyro_scale[rg_roll.ItemIndex]-3500)div 8)+50;
               lb_k3.Caption:=inttostr(((tb_k3.Position-50)*8)+3500);
                   end;
               2 : begin
               tb_k3.Position:=((eepr.gyro_scale[rg_roll.ItemIndex]-1750)div 4)+50;
               lb_k3.Caption:=inttostr(((tb_k3.Position-50)*4)+1750);
                   end;
               3 : begin
               tb_k3.Position:=((eepr.gyro_scale[rg_roll.ItemIndex]-875)div 2)+50;
