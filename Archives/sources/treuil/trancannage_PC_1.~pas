            btn_calibr_acc.Caption:='étape 6';
            memo1.Lines.Add('Z vers le nord');
            memo1.Lines.Add('  puis cliquer sur ''étape 6''');
            end;
        7 : begin
            if connected then  sendbyte(port,COMMAND_STORE_MAX_MAG_Z);
            btn_calibr_acc.Caption:='calibr_acc';
            memo1.Lines.Add('-Fin calibration magnétos');
            state_calibr_acc:=0;
            end;
    end;
   end;
  end;
end;

