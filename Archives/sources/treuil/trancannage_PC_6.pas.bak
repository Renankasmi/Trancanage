procedure TForm1.LOGClick(Sender: TObject);
var i:integer;
    fic: string;
begin
if  connected then
 begin
    if LOG.Caption='LOG' then
    begin
     if cb_select.Checked then
        begin
          i:=1;
          repeat
            fic:=extractfilepath(Application.ExeName)+'log_'+inttostr(i)+'.tct';
            i:=i+1;
          until  (fileexists(fic)=false);
          assignfile(f,fic);
          rewrite(f);
          memo1.Lines.Add('-enregistrement dans : ');
          memo1.Lines.Add(fic);

          LOG.Caption:='STOP_LOG';
          log_running:=true;

        end
        else
        begin
           LOG.Caption:='wait';

        end;
    end
    else
    begin
         LOG.Caption:='LOG';
          memo1.Lines.Add('-fin enregistrement log');
          log_eeprom_file;
          closefile(f);
          log_running:=false;

    end;

 end;
end;

procedure TForm1.btn_selClick(Sender: TObject);
begin
       if cb_select.Checked then
          begin
              cb_select.Caption:='select';
             if connected then  sendbyte(port,COMMAND_STOP);
          end
        else
          begin
            cb_select.Caption:='selected';
             if connected then  sendbyte(port,COMMAND_RUN);
             if LOG.Caption='wait' then
               begin
                LOG.Caption:='LOG';
                LOG.Click;
               end;
          end;
end;

end.

