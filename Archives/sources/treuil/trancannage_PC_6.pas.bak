type
  TDataRec = record
    nb_data: Integer;
    data_size,data_type : array[0..9] of integer;
                   //0 pour entier non signé
                   //1 pour entier signé
                   //2 pour float ieee
                   //3 pour float microchip
                   //4 pour calcul particulier
                   //5 pour affichage hexa
                   //6 calcul courant
                   //7 calcul tension
                   //8 vérif si >10000 , càd selected
    data_text: array[0..9] of string;
    data_curve: array[0..9] of Tcolor;
    data_scale : array[0..9] of real;
    data_zero : array[0..9] of integer;
  end;
  TConfig = record
        version : integer;
        flags : integer;
	offset_as5040 : integer;
	volts_manuel : integer;
	largeur_bobine : integer;
	freq_boucle : integer;
	idata1 : integer;
	Kp_I : integer;
	Ki_I : integer;
	I_lim : integer;
	vit_simu_bobine : integer;
	idata6 : integer;
	idata7 : integer;
	idata8 : integer;
	idata9 : integer;
	idata10 : integer;
    //int d'abord , float après
	Kp : single;
	Ki : single;
	Kd : single;
	pas : single;
        fdata1 : single;
        fdata2 : single;
        fdata3 : single;
        fdata4 : single;
        fdata5 : single;
        fdata6 : single;
        fdata7 : single;
        fdata8 : single;
        fdata9 : single;
        fdata10 : single;
  end;

