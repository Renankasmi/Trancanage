tab_coche1[8]:=0;
tab_coche1[9]:=0;
tab_coche1[10]:=0;
tab_coche2[1]:=0;
tab_coche2[2]:=0;
tab_coche2[3]:=1;
tab_coche2[4]:=1;
tab_coche2[5]:=0;
tab_coche2[6]:=0;
tab_coche2[7]:=1;
