                      00150                 movf    EEDATA,w        ; charger valeur lue
                      00151                 bcf     STATUS,RP0      ; passer en banque0
                      00152         endm
                      00153 
                      00154 
                      00155 WEEPROM macro   addwrite        ; la donnée se trouve dans W
                      00156         LOCAL   loop
                      00157         bsf     STATUS,RP0      ; passer en banque1
                      00158         movwf   EEDATA          ; placer data dans registre
                      00159         movlw   addwrite        ; charger adresse d'écriture
                      00160         movwf   EEADR           ; placer dans registre
                      00161         bsf     EECON1 , WREN   ; autoriser accès écriture
                      00162         bcf     INTCON , GIE    ; interdire interruptions
                      00163         movlw   0x55            ; charger 0x55
                      00164         movwf   EECON2          ; envoyer commande
                      00165         movlw   0xAA            ; charger 0xAA
                      00166         movwf   EECON2          ; envoyer commande
                      00167         bsf     EECON1 , WR     ; lancer cycle d'écriture
                      00168         bsf     INTCON , GIE    ; réautoriser interruptions
                      00169 loop
                      00170         btfsc   EECON1 , WR     ; tester si écriture terminée
                      00171         goto    loop            ; non, attendre
                      00172         bcf     EECON1 , WREN   ; verrouiller prochaine écriture
                      00173         bcf     STATUS , RP0    ; passer en banque0
                      00174         endm
