                      00033 ; REGISTRE OPTION_REG (configuration)
                      00034 ; -----------------------------------
  00000007            00035 OPTIONVAL       EQU     B'00000111'
                      00036                         ; NOT_GPPU b7 : 0= Résistance rappel +5V en service
                      00037                         ; INTEDG   b6 : 1= Interrupt sur flanc montant de gp2/int
                      00038                         ;              -- 0= Interrupt sur flanc descend. de gp2/int
                      00039                         ; TOCS      b5 : 1= source clock = transition sur gp2/t0cki
                      00040                         ;                0= horloge interne
                      00041                         ; TOSE      b4 : 1= Sélection flanc descendant gp2/t0cki(si B5=1)
                      00042                         ;                0= Sélection flanc montant gp2
                      00043                         ; PSA       b3 : 1= Assignation prédiviseur sur Watchdog
MPASM  5.51                       REGUL_2.ASM   5-1-2014  13:28:31         PAGE  2


LOC  OBJECT CODE     LINE SOURCE TEXT
  VALUE

                      00044                         ;                --0= Assignation prédiviseur sur Tmr0
                      00045                         ; PS2/PS0   b2/b0 valeur du prédiviseur
                      00046             ;           000 =  1/1 (watchdog) ou 1/2 (tmr0)
                      00047                         ;           001 =  1/2               1/4
                      00048                         ;           010 =  1/4               1/8
                      00049                         ;           011 =  1/8               1/16  16*256*256=268sec
                      00050                         ;           100 =  1/16              1/32
                      00051                         ;           101 =  1/32              1/64
                      00052                         ;           110 =  1/64              1/128
                      00053                         ;           111 =  1/128        ---     1/256
                      00054 
                      00055 
                      00056 ; REGISTRE INTCON (contrôle interruptions standard)
                      00057 ; -------------------------------------------------
  00000070            00058 INTCONVAL       EQU     B'01110000'
                      00059                         ; GIE       b7 : masque autorisation générale interrupt
                      00060                         ;                ne pas mettre ce bit à 1 ici
                      00061                         ;                sera mis en temps utile
                      00062                         ; --PEIE      b6 : masque autorisation générale périphériques
                      00063                         ; --T0IE      b5 : masque interruption tmr0
                      00064                         ; --INTE      b4 : masque interuption gp2/Int
                      00065                         ; GPIE      b3 : masque interruption changement d'une des gpio
                      00066                         ; T0IF      b2 : flag tmr0
                      00067                         ; INTF      b1 : flag gp2/Int
                      00068                         ; RBIF      b0 : flag interruption changement d'une des gpio
                      00069 
                      00070 ; REGISTRE PIE1 (contrôle interruptions périphériques)
                      00071 ; ----------------------------------------------------
  00000001            00072 PIE1VAL         EQU     B'00000001'
                      00073                         ; EEIE      b7 : masque interrupt écriture EEPROM
                      00074                         ; ADIE      b6 : masque interrupt convertisseur A/D
                      00075                         ; ----      b4 : toujours 0 sur 12f629
                      00076                         ; ----      b4 : toujours 0 sur 12f629
                      00077                         ; CMIE      b3 : masque interrupt changement sur sortie comparateur
                      00078                         ; ----      b2 : toujours 0 sur 12f629
                      00079                         ; ----      b2 : toujours 0 sur 12f629
                      00080                         ; --TMR1IE    b0 : masque interrupt débordement tmr1
                      00081 
  00000007            00082 CMCONVAL  EQU B'00000111' ; module comparateur off
                      00083                                                         
                      00084 ; DIRECTION DES PORTS I/O
                      00085 ; -----------------------
                      00086 
  0000001E            00087 DIRGPIO EQU     B'00011110'     ; Direction GPIO (1=entrée)
