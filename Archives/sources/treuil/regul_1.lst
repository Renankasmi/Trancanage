                      00155 
                      00156 WEEPROM macro   addwrite        ; la donnée se trouve dans W
                      00157         LOCAL   loop
                      00158         bsf     STATUS,RP0      ; passer en banque1
                      00159         movwf   EEDATA          ; placer data dans registre
                      00160         movlw   addwrite        ; charger adresse d'écriture
                      00161         movwf   EEADR           ; placer dans registre
                      00162         bsf     EECON1 , WREN   ; autoriser accès écriture
                      00163         bcf     INTCON , GIE    ; interdire interruptions
                      00164         movlw   0x55            ; charger 0x55
                      00165         movwf   EECON2          ; envoyer commande
                      00166         movlw   0xAA            ; charger 0xAA
                      00167         movwf   EECON2          ; envoyer commande
                      00168         bsf     EECON1 , WR     ; lancer cycle d'écriture
                      00169         bsf     INTCON , GIE    ; réautoriser interruptions
                      00170 loop
                      00171         btfsc   EECON1 , WR     ; tester si écriture terminée
                      00172         goto    loop            ; non, attendre
                      00173         bcf     EECON1 , WREN   ; verrouiller prochaine écriture
                      00174         bcf     STATUS , RP0    ; passer en banque0
                      00175         endm
